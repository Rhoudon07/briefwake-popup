<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Necesario para listar todas las apps instaladas y que el usuario elija cuáles activan el resumen -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Encender la pantalla brevemente al llegar una notificación con pantalla apagada -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Permitir abrir la ventana emergente desde segundo plano en Android 10+ -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Evitar que Samsung One UI duerma el servicio en segundo plano -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Soporte para full screen intent y pruebas de notificación -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BriefWakePopup">

        <!-- Actividad principal de configuración y selección de apps -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.BriefWakePopup">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Actividad emergente con fondo negro AMOLED sobre pantalla apagada/bloqueada -->
        <activity
            android:name=".BriefPopupActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:noHistory="true"
            android:showOnLockScreen="true"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@style/Theme.BriefPopupOverlay" />

        <!-- Servicio que intercepta notificaciones entrantes -->
        <service
            android:name=".BriefNotificationListenerService"
            android:exported="true"
            android:label="@string/service_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>

</manifest>

